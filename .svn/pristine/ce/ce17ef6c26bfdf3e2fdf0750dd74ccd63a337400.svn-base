#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Enjoying Intastellar Consents? Leave us a review on WordPress.org — it helps others discover the plugin."
msgstr "Vous aimez Intastellar Consents ? Laissez-nous un avis sur WordPress.org — cela aide d'autres utilisateurs à découvrir l'extension."

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Leave a review"
msgstr "Laisser un avis"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Open on WordPress.org"
msgstr "Ouvrir sur WordPress.org"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Maybe later"
msgstr "Plus tard"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Leave a review on WordPress.org"
msgstr "Laisser un avis sur WordPress.org"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Your review helps other users and supports the plugin. Thank you!"
msgstr "Votre avis aide les autres utilisateurs et soutient l'extension. Merci !"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Open review page"
msgstr "Ouvrir la page d'avis"

#: includes/intastellarGDPRAdminPanelHeader.php
msgid "Close"
msgstr "Fermer"
