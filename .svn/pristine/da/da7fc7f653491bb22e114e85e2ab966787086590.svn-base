function intastellarCookieBranding()
{
    $brand_color = get_option('intastellarCookieBannerColor');
    if (empty($brand_color)) {
        $hex = get_theme_mod('background_color');
        $brand_color = $hex ? '#' . ltrim($hex, '#') : '#c09f53';
    }
    if (strpos($brand_color, '#') !== 0) {
        $brand_color = '#' . ltrim($brand_color, '#');
    }
    $logo_url = get_option('intastellarCustomIcon');
    $brand_name = get_option('intastellarCookieBanner-brandName') ? get_option('intastellarCookieBanner-brandName') : get_bloginfo('name');
?>
    <section class="intastellarPluginContent">
        <?php include("intastellarGDPRAdminPanelHeader.php"); ?>
        <section class="intastellarPluginGrid">
            <div class="intastellarPluginContent">
                <header class="intastellarPluginPage-header">
                    <h3 class="intastellarPluginHeader__headline"><?php esc_html_e('Branding', 'intastellar-consents'); ?></h3>
                </header>

                <div class="intastellar-branding-page">
                    <form method="post" action="options.php" enctype="multipart/form-data" class="intastellar-branding-page__form">
                        <?php settings_fields('intastellar-consents_plugin_options-group'); ?>

                        <div class="intastellar-branding-page__cards">
                            <div class="intastellar-branding-page__card">
                                <label for="intastellarCookieBanner-brandName" class="intastellar-settings-dashboard__card-label"><?php esc_html_e('Company name', 'intastellar-consents'); ?></label>
                                <input type="text" class="intastellar-branding-page__input" id="intastellarCookieBanner-brandName" name="intastellarCookieBanner-brandName" value="<?php echo esc_attr($brand_name); ?>" placeholder="<?php esc_attr_e('Your company name', 'intastellar-consents'); ?>">
                            </div>

                            <div class="intastellar-branding-page__card">
                                <label for="intastellarCookieBannerColor_id" class="intastellar-settings-dashboard__card-label"><?php esc_html_e('Brand color', 'intastellar-consents'); ?></label>
                                
                                <div class="intastellar-branding-page__color-row">
                                    <input type="color" class="intastellar-branding-page__preview-color" id="intastellarCookieBannerColor_id" name="intastellarCookieBannerColor" value="<?php echo esc_attr($brand_color); ?>">
                                    <input type="text" class="intastellar-branding-page__color-hex" id="intastellarCookieBannerColorValue" value="<?php echo esc_attr($brand_color); ?>" maxlength="7">
                                </div>
                            </div>

                            <div class="intastellar-branding-page__card">
                                <label for="intastellarCustomIconButton" class="intastellar-settings-dashboard__card-label"><?php esc_html_e('Company logo', 'intastellar-consents'); ?></label>
                                <div class="intastellar-branding-page__card-preview">
                                    <div class="intastellar-branding-page__preview-logo-wrap">
                                        <?php if ($logo_url) : ?>
                                            <img src="<?php echo esc_url($logo_url); ?>" alt="" class="intastellar-branding-page__preview-logo" id="intastellarCustomIconPreview">
                                        <?php else : ?>
                                            <span class="intastellar-branding-page__preview-no-logo" id="intastellarBrandingPreviewPlaceholder"><?php esc_html_e('No logo', 'intastellar-consents'); ?></span>
                                            <img src="" alt="" class="intastellar-branding-page__preview-logo" id="intastellarCustomIconPreview" style="display:none">
                                        <?php endif; ?>
                                    </div>
                                </div>
                                <p class="intastellar-branding-page__hint"><?php esc_html_e('Recommended: max-width 200px, min-width 100px for near-square logos.', 'intastellar-consents'); ?></p>
                                <input type="hidden" id="intastellarCustomIcon_id" name="intastellarCustomIcon" value="<?php echo esc_attr($logo_url ? $logo_url : ''); ?>">
                                <button type="button" class="button" id="intastellarCustomIconButton"><?php esc_html_e('Select or Upload Logo', 'intastellar-consents'); ?></button>
                            </div>
                        </div>

                        <input type="hidden" id="intastellarPrivacyLink_id" name="intastellarPrivacyLink" value="<?php echo esc_attr(get_option('intastellarPrivacyLink')); ?>">
                        <input type="hidden" id="intastellarSelectLanguage_id" name="intastellarSelectLanguage" value="<?php echo esc_attr(get_option('intastellarSelectLanguage')); ?>">
                        <input type="hidden" name="intastellarSetCookiePosition" id="intastellarSetCookiePosition_id" value="<?php echo esc_attr(get_option('intastellarSetCookiePosition')); ?>">
                        <input type="hidden" id="intastellarPrivacyLink-checkbox" name="intastellarPrivacyLink-checkbox" value="<?php echo esc_attr(get_option('intastellarPrivacyLink-checkbox')); ?>">
                        <input type="hidden" name="intastellarDisplayCookieAdvenced" id="intastellarDisplayCookieAdvenced" value="<?php echo esc_attr(get_option('intastellarDisplayCookieAdvenced')); ?>">
                        <input type="hidden" name="intastellarDisplayCookieNoticeText" id="intastellarDisplayCookieNoticeText" value="<?php echo esc_attr(get_option('intastellarDisplayCookieNoticeText')); ?>">
                        <input type="hidden" name="intastellarSiteRoot" id="rootDomain" value="<?php echo esc_attr(get_option('intastellarSiteRoot')); ?>">
                        <input type="hidden" name="intastellarBannerStyle" value="<?php echo esc_attr(get_option('intastellarBannerStyle') ? get_option('intastellarBannerStyle') : 'overlay'); ?>">
