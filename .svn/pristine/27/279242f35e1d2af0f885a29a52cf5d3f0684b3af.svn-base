    require_once(ABSPATH.'wp-admin/includes/plugin.php');

    function intastellarSettingsRegistration() {
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarCustomIcon');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarCookieBannerColor');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarPrivacyLink');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarPrivacyLink-checkbox');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarSetCookiePosition');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarDisplayCookieNoticeText');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarSelectLanguage');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group','intastellarCCPA');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group','intastellarCCPAUrl');
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', "intastellarDisplayCookieAdvenced");
        register_setting('intastellar-gdpr-cookiebanner_plugin_options_group', 'intastellarCCPAcollection');
    }

    add_action('admin_init', 'intastellarSettingsRegistration', 1);
    add_action( 'admin_enqueue_scripts', 'initIntastellarAdminStyles', 1);
    
    function initIntastellarAdminStyles() {
        wp_register_style( 'intastellarStyle', plugin_dir_url( __FILE__ ) . 'intastellarAdminStyle.css', false, '1.5.0' );
        wp_enqueue_style('intastellarStyle');
        wp_enqueue_script('intastellarScript', plugin_dir_url( __FILE__ ) . 'intastellarAdminScript.js', false, '1.5.0');
    }

    function initIntastellarSettingsPage() {
        add_menu_page('Intastellar GDPR Cookie banner', 'Intastellar GDPR Cookie banner', 'manage_options', 'intastellar-gdpr-cookiebanner', 'intastellarGDPRSettingsForm', 'data:image/svg+xml;base64,');
        add_submenu_page( "intastellar-gdpr-cookiebanner", "Intro", "Intro", "manage_options", "intastellar-gdpr-cookiebanner", "intastellarGDPRSettingsForm", null);
        add_submenu_page( "intastellar-gdpr-cookiebanner", "Branding", "Branding", "manage_options", "intastellar-gdpr-cookiebanner/branding", "intastellarCookieBranding", null);
        add_submenu_page( "intastellar-gdpr-cookiebanner", "Settings", "Settings", "manage_options", "intastellar-gdpr-cookiebanner/settings", "intastellarCookieSettings", null);
        add_submenu_page( "intastellar-gdpr-cookiebanner", "Privacy", "Privacy", "manage_options", "intastellar-gdpr-cookiebanner/privacy", "intastellarGDPRPrivacyPage", null);
    }
    add_action('admin_menu', 'initIntastellarSettingsPage');

    if( strpos($_SERVER["REQUEST_URI"],"wp-login.php") === false && !is_admin() ){
        add_action("init", "loadIntastellarCookieBanner");
    }

    function loadIntastellarCookieBanner(){
        if(get_option('intastellarCustomIcon')){
            $logo = get_option('intastellarCustomIcon');
        }else{
            $logo = "";
        }

        if(get_option("intastellarDisplayCookieAdvenced")){
            $advanced = filter_var(get_option('intastellarDisplayCookieAdvenced'), FILTER_VALIDATE_BOOLEAN);
        }else {
            $advanced = false;
        }

        if(get_option("intastellarCookieBannerColor")){
            $color = get_option("intastellarCookieBannerColor");
        }else{
            $color = get_theme_mod( 'background_color' );
        }

        if(get_option('intastellarPrivacyLink-checkbox')){
            $link = array(
                "url" => get_option('intastellarPrivacyLink'),
                "target" => "_blank"
            );
        }else{
            $link = get_option('intastellarPrivacyLink');
        }
        $collection = explode("\n", get_option('intastellarCCPAcollection'));

        wp_add_inline_script( 'intastellar-gdpr-settings'
            , 'window.INTA = ' . json_encode( array(
                'policy_link' => $link,
                'settings' => array(
                    'language' => get_option("intastellarSelectLanguage"),
                    'arrange' => get_option("intastellarSetCookiePosition"),
                    'logo' => $logo,
                    'color' => $color,
                    'text' => filter_var(get_option('intastellarDisplayCookieNoticeText'), FILTER_VALIDATE_BOOLEAN),
                    'ccpa' => array(
                        "on" => filter_var(get_option('intastellarCCPA'), FILTER_VALIDATE_BOOLEAN),
                        "url" => get_option('intastellarCCPAurl'),
                        "collection" => $collection
                    ),
                    'advanced' => $advanced
                ),
            ) ), 'after'
        );
    }

?>
